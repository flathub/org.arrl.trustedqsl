{
    "app-id" : "org.arrl.trustedqsl",
    "runtime" : "org.freedesktop.Platform",
    "runtime-version" : "24.08",
    "sdk" : "org.freedesktop.Sdk",
    "command" : "tqsl",
    "finish-args" : [
	"--share=network",
	"--socket=x11",
	"--share=ipc",
	"--filesystem=home"
     ],
    "modules" : [
	{
	    "name" : "wxWidgets",
	    "buildsystem" : "cmake-ninja",
    	    "config-opts" : [
		    "-DwxUSE_OPENGL=No",
		    "-DwxUSE_HTML=Yes",
		    "-DwxUSE_STREAMS=Yes",
		    "-DwxUSE_WXHTML_HELP=Yes",
		    "-DCMAKE_BUILD_TYPE=Release",
		    "-DwxUSE_UNICODE=Yes"
	    ],
	    "cleanup" : [
			"/lib/wx",
			"/bin/wx-config",
			"/bin/wxrc",
			"/bin/wxrc-3.2",
			"/share/bakefile",
			"/include",
			"/lib/cmake"
	    ],
	    "sources" : [
		{
		    "type" : "archive",
        	    "url" : "https://github.com/wxWidgets/wxWidgets/releases/download/v3.2.10/wxWidgets-3.2.10.tar.bz2",
        	    "sha256" : "d66e929569947a4a5920699539089a9bda83a93e5f4917fb313a61f0c344b896"
	  	}
	    ]
	},
	{
	    "name" : "tqsl",
	    "buildsystem" : "cmake-ninja",
    	    "config-opts" : [
	        "-DTQSL_FLATPAK=Yes",
		"-DCMAKE_BUILD_TYPE=Release"
	    ],
	    "cleanup" : [
		"/include"
	    ],
	    "sources" : [
		{
		    "type" : "archive",
        	    "url" : "https://www.rickmurphy.net/lotw/tqsl-2.8.6.tar.gz",
        	    "sha256" : "182e5f2ac35a3db8b409b45d96505e6bd265ae4668ed064754209c4b8e7bdf37"
	  	}
	    ]
	}
    ]
}
