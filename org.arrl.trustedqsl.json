{
    "app-id" : "org.arrl.trustedqsl",
    "runtime" : "org.freedesktop.Platform",
    "runtime-version" : "26.08",
    "sdk" : "org.freedesktop.Sdk",
    "command" : "tqsl",
    "finish-args" : [
	"--share=network",
	"--socket=x11",
	"--share=ipc",
	"--filesystem=home"
     ],
    "modules" : [
	{
	    "name" : "wxWidgets",
	    "buildsystem" : "cmake-ninja",
    	    "config-opts" : [
		    "-DwxUSE_OPENGL=No",
		    "-DwxUSE_HTML=Yes",
		    "-DwxUSE_STREAMS=Yes",
		    "-DwxUSE_WXHTML_HELP=Yes",
		    "-DCMAKE_BUILD_TYPE=Release",
		    "-DwxUSE_UNICODE=Yes"
	    ],
	    "cleanup" : [
			"/lib/wx",
			"/bin/wx-config",
			"/bin/wxrc",
			"/bin/wxrc-3.2",
			"/share/bakefile",
			"/include",
			"/lib/cmake"
	    ],
	    "sources" : [
		{
		    "type" : "archive",
		    "url" : "https://github.com/wxWidgets/wxWidgets/releases/download/v3.2.12/wxWidgets-3.2.12.tar.bz2",
        	    "sha256" : "a62719bb5e1dcc41c1a6fc1eecd499c7ee8521f70402c7b1bb3342a1e16344e0"
	  	}
	    ]
	},
	{
	    "name" : "tqsl",
	    "buildsystem" : "cmake-ninja",
    	    "config-opts" : [
	        "-DTQSL_FLATPAK=Yes",
		"-DCMAKE_BUILD_TYPE=Release"
	    ],
	    "cleanup" : [
		"/include"
	    ],
	    "sources" : [
		{
		    "type" : "archive",
        	    "url" : "https://www.rickmurphy.net/lotw/tqsl-2.8.7.tar.gz",
        	    "sha256" : "37848c8eb189d1df57dda7bc4e59fcae0053ae48cd15b7667e2b9d1391a0f37c"
	  	}
	    ]
	}
    ]
}
